<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="32dp" android:background="@color/larz_bg">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="λ" android:textColor="@color/larz_lambda"
        android:textSize="72sp" android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/setup_title" android:textColor="@color/larz_text"
        android:textSize="22sp" android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/setup_body" android:textColor="@color/larz_muted"
        android:textSize="14sp" android:gravity="center"
        android:layout_marginTop="8dp" android:layout_marginBottom="24dp" />

    <ProgressBar
        android:id="@+id/bar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:max="100"
        android:indeterminateTint="@color/larz_lambda" android:progressTint="@color/larz_lambda"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/action"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/setup_start"
        android:backgroundTint="@color/larz_lambda" android:textColor="#04121A" />
</LinearLayout>
